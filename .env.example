# Copy to .env and fill in. .env holds live credentials — never commit it.
#
#   1. ETSY_KEYSTRING + ETSY_SHARED_SECRET — register an app at
#                        https://www.etsy.com/developers/register and copy BOTH from
#                        "See API Key Details". Etsy wants them joined as
#                        "keystring:shared_secret" in the x-api-key header; the keystring
#                        alone returns 403. Verify with:
#                            python -m etsypub.publish --preflight
#   2. ETSY_REDIRECT_URI — must match the callback you registered on that app EXACTLY,
#                        including scheme and port. Etsy's form only accepts https://,
#                        so this stays https and `python -m etsypub.oauth` asks you to
#                        paste the redirect URL back rather than listening for it.
#   3. python -m etsypub.oauth      -> fills in ETSY_REFRESH_TOKEN and ETSY_SHOP_ID
#   4. python -m etsypub.taxonomy --search digital  -> pick ETSY_TAXONOMY_ID

ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://localhost:3003/oauth/redirect
ETSY_SCOPES=listings_r listings_w shops_r

# Written automatically by `python -m etsypub.oauth` — leave blank to start.
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=

# Chosen deliberately via `python -m etsypub.taxonomy`. No default: an id guessed here
# would put every listing in the wrong category.
ETSY_TAXONOMY_ID=

# Listing defaults
ETSY_VOLUMES=1,2,3,4,5,6
ETSY_QUANTITY=999
ETSY_WHO_MADE=i_did
# Etsy's recent-years bucket rolls forward each year. If create 400s on this, the error
# body lists the valid enum values — copy the newest one in.
ETSY_WHEN_MADE=2020_2026
ETSY_IS_SUPPLY=false

# Pacing. Publishing a whole catalogue in one sitting is what gets a young shop reviewed.
ETSY_PER_RUN=2
ETSY_JITTER_MIN=3
ETSY_JITTER_MAX=8
