{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "async": true,
            "timeout": 10,
            "command": "[console]::beep(880,150); [console]::beep(1320,200)"
          }
        ]
      }
    ]
  }
}
