{
  "mcpServers": {
    "[vendor-name]": {
      "type": "http",
      "url": "[https://mcp.example.com/mcp]"
    },
    "[vendor-with-auth]": {
      "type": "http",
      "url": "[https://mcp.example.com/mcp]",
      "headers": {
        "Authorization": "Bearer ${[VENDOR_API_TOKEN]}"
      }
    }
  }
}
